{
 "uid": "nisar-pro",
 "title": "NISAR Pro",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Gateway up",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=\"nisar-pro\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "#d6dae1"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Engine found",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "nisar_engine_ready",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "#d6dae1"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Free engine slots",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "nisar_processor_free_slots",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "#d6dae1"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Runs running",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "nisar_jobs{status=\"running\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "#d6dae1"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Runs queued",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "nisar_jobs{status=\"queued\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "#d6dae1"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Uptime",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - nisar_process_start_time_seconds",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "fixed",
      "fixedColor": "#d6dae1"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Engine run time (p50, p90)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum(rate(nisar_run_duration_seconds_bucket[1h])) by (le))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.9, sum(rate(nisar_run_duration_seconds_bucket[1h])) by (le))",
     "legendFormat": "p90",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Runs per hour",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(nisar_runs_completed_total[1h])",
     "legendFormat": "completed",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "increase(nisar_runs_failed_total[1h])",
     "legendFormat": "failed",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "C",
     "expr": "increase(nisar_runs_reused_total[1h])",
     "legendFormat": "reused (identical request)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "HTTP responses per second",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (class) (rate(nisar_http_responses_total[5m]))",
     "legendFormat": "{{class}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Runs by status",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "nisar_jobs",
     "legendFormat": "{{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   }
  }
 ],
 "tags": [
  "nisar"
 ]
}